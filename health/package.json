{
  "name": "health",
  "version": "0.1.5",
  "description": "Codebase Health benchmark CLI",
  "private": true,
  "license": "Elastic-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "health": "dist/bin.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:tools": "HEALTH_TOOLS=1 vitest run test/tools",
    "test:docker": "HEALTH_DOCKER=1 vitest run test/docker",
    "image:build": "docker build -t health:1.0 -f docker/Dockerfile docker",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "build": "tsc -p tsconfig.build.json",
    "health": "tsx src/bin.ts"
  },
  "dependencies": {
    "@typescript-eslint/parser": "8.71.0",
    "dependency-cruiser": "18.5.0",
    "eslint": "9.39.5",
    "eslint-plugin-sonarjs": "4.2.2",
    "ignore": "^7.0.12",
    "jscpd": "5.4.0",
    "knip": "6.39.0",
    "picomatch": "^4.0.7",
    "semver": "7.8.5",
    "smol-toml": "1.9.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.71.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/picomatch": "^4.0.3",
    "@types/semver": "^7.8.0",
    "tsx": "^4.23.15",
    "vitest": "^4.1.11"
  }
}
