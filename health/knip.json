{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/bin.ts",
    "src/cli.ts",
    "src/**/*.test.ts",
    "test/**/*.ts",
    "vitest.config.ts",
    "eslint.config.js"
  ],
  "project": ["src/**/*.ts", "test/**/*.ts"],
  "ignore": ["test/fixtures/**", "dist/**", "docker/config/**"]
}
